diff --git a/addons/remote-buttons/app/src/main/res/values/strings.xml b/addons/remote-buttons/app/src/main/res/values/strings.xml
new file mode 100644
index 0000000..8902a31
--- /dev/null
+++ b/addons/remote-buttons/app/src/main/res/values/strings.xml
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="app_name">Remote Buttons</string>
+    <string name="service_label">Remote Buttons redirects</string>
+    <string name="service_description">Opens the app you chose when another app comes to the front, so a remote\'s app button can open a different app. It only sees which app is in front: never your keys, never what is on screen.</string>
+    <string name="intro">Your remote\'s app buttons each open a fixed app. A rule here makes that app open another one instead, for example YouTube to SmartTube. Volume, the arrows, OK and Home are never touched.</string>
+    <string name="service_on">● Redirects are on</string>
+    <string name="service_off">● Redirects are off. Press OK, then turn on Remote Buttons redirects</string>
+    <string name="rules_title">RULES (OK on a rule removes it)</string>
+    <string name="no_rules">No rules yet.</string>
+    <string name="rule_row">When %1$s opens → open %2$s</string>
+    <string name="add_rule">+ Add rule</string>
+    <string name="screen_of">%1$s (%2$s screen)</string>
+    <string name="pick_from">Which app does the button open now?</string>
+    <string name="pick_to">When %1$s opens, open…</string>
+    <string name="remove">Remove rule</string>
+    <string name="hint">Tip: an app a rule redirects also redirects when you open it from Home. Netflix and Prime Video buttons work on their own; add a rule only to change what they open.</string>
+</resources>
diff --git a/addons/remote-buttons/app/src/main/res/xml/redirect_service.xml b/addons/remote-buttons/app/src/main/res/xml/redirect_service.xml
new file mode 100644
index 0000000..92b51b1
--- /dev/null
+++ b/addons/remote-buttons/app/src/main/res/xml/redirect_service.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Window changes only. No flagRequestFilterKeyEvents and no window content: a key-filtering service makes this
+     TV drop held-key repeat (volume one step per press), and this one never sees a key. -->
+<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
+    android:accessibilityEventTypes="typeWindowStateChanged"
+    android:accessibilityFeedbackType="feedbackGeneric"
+    android:accessibilityFlags="flagDefault"
+    android:canRetrieveWindowContent="false"
+    android:description="@string/service_description"
+    android:notificationTimeout="100" />
diff --git a/addons/remote-buttons/app/src/test/java/io/github/opentvos/remotebuttons/RulesTest.java b/addons/remote-buttons/app/src/test/java/io/github/opentvos/remotebuttons/RulesTest.java
new file mode 100644
index 0000000..51f8a10
--- /dev/null
+++ b/addons/remote-buttons/app/src/test/java/io/github/opentvos/remotebuttons/RulesTest.java
@@ -0,0 +1,57 @@
+package io.github.opentvos.remotebuttons;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.Map;
+
+public class RulesTest {
+    @Test
+    public void parsesRulesAndSkipsBadOnes() {
+        Map<String, String> r = Rules.parse(new HashSet<>(Arrays.asList(
+                Rules.DEFAULT,
+                "com.netflix.ninja=com.netflix.ninja",   // to itself
+                "nonsense",
+                "a=b",                                   // not package names
+                "com.amazon.amazonvideo.livingroom=in.startv.hotstar")));
+        assertEquals(2, r.size());
+        assertEquals("org.smarttube.stable", r.get("com.google.android.youtube.tv"));
+        assertEquals("in.startv.hotstar", r.get("com.amazon.amazonvideo.livingroom"));
+    }
+
+    @Test
+    public void onePerFromApp() {
+        Map<String, String> r = Rules.parse(new HashSet<>(Arrays.asList(
+                "com.example.a=com.example.b", "com.example.a=com.example.c")));
+        assertEquals(1, r.size());
+    }
+
+    @Test
+    public void packageNames() {
+        assertTrue(Rules.valid("org.smarttube.stable"));
+        assertFalse(Rules.valid("smarttube"));
+        assertFalse(Rules.valid("org.smart tube"));
+    }
+
+    @Test
+    public void oneScreenRulesMatchBeforeThePackage() {
+        Map<String, String> r = Rules.parse(new HashSet<>(Arrays.asList(Rules.DEFAULT, Rules.HOME)));
+        assertEquals(2, r.size());
+        String lx = "com.google.android.apps.tv.launcherx";
+        assertEquals("com.gathin.tvhome", Rules.target(r, lx, lx + ".home.HomeActivity"));
+        assertEquals(null, Rules.target(r, lx, lx + ".search.SearchActivity"));   // its other screens stay
+        assertEquals("org.smarttube.stable", Rules.target(r, "com.google.android.youtube.tv", "x.Y"));
+        assertEquals(lx + "/.home.HomeActivity", Rules.screenKey(lx, lx + ".home.HomeActivity"));
+        assertEquals("a.b/c.d.E", Rules.screenKey("a.b", "c.d.E"));
+    }
+
+    @Test
+    public void nullIsEmpty() {
+        assertTrue(Rules.parse(null).isEmpty());
+    }
+}

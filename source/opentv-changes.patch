+++ b/addons/remote-buttons/app/src/main/java/io/github/opentvos/remotebuttons/Rules.java
@@ -0,0 +1,103 @@
+package io.github.opentvos.remotebuttons;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * The redirect rules, "from package" to "to package": when the from app comes to the front, the to app opens
+ * instead. A remote's app buttons open a fixed app (Xiaomi's YouTube button always asks for the stock YouTube),
+ * so redirecting that app is how such a button is remapped without filtering keys, which on this TV drops a
+ * held button's repeat (volume one step per press).
+ */
+final class Rules {
+    static final String PREFS = "rules";
+    private static final String KEY = "rules";
+    private static final String SEEDED = "seeded_version";
+    /** The stock YouTube app (and its remote button) opens SmartTube. */
+    static final String DEFAULT = "com.google.android.youtube.tv=org.smarttube.stable";
+    /**
+     * The Google TV home screen opens the Clean Your TV launcher. launcherx has to stay enabled because it alone
+     * receives the remote's YouTube button (KEYCODE_BUTTON_3 in the TV's global keys); enabled, it claims Home, so
+     * only its home screen (not its other screens) is sent back. The from side names one screen: package/class.
+     */
+    static final String HOME = "com.google.android.apps.tv.launcherx/.home.HomeActivity=com.gathin.tvhome";
+    /**
+     * Defaults for a fresh install: only the Google TV home redirect. YouTube -> SmartTube ({@link #DEFAULT}) is no
+     * longer added by itself, since a family using voice search needs the stock YouTube; add it on the TV if wanted.
+     */
+    private static final String[][] DEFAULTS = {{HOME}};
+
+    private Rules() { }
+
+    /**
+     * "a=b" lines to a map; malformed lines, a rule to itself and repeats of a from side are skipped. The from side is
+     * a package, or package/.Screen (one activity, the class relative to the package) for a single screen.
+     */
+    static Map<String, String> parse(Set<String> lines) {
+        Map<String, String> out = new LinkedHashMap<>();
+        if (lines == null) return out;
+        for (String line : new TreeSet<>(lines)) {
+            int eq = line.indexOf('=');
+            if (eq <= 0 || eq == line.length() - 1) continue;
+            String from = line.substring(0, eq).trim(), to = line.substring(eq + 1).trim();
+            if (!validFrom(from) || !valid(to) || packageOf(from).equals(to) || out.containsKey(from)) continue;
+            out.put(from, to);
+        }
+        return out;
+    }
+
+    static boolean valid(String pkg) {
+        return pkg.matches("[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+");
+    }
+
+    static boolean validFrom(String from) {
+        int slash = from.indexOf('/');
+        if (slash < 0) return valid(from);
+        String cls = from.substring(slash + 1);
+        return valid(from.substring(0, slash)) && cls.matches("\\.?[A-Za-z_][A-Za-z0-9_$]*(\\.[A-Za-z0-9_$]+)*");
+    }
+
+    static String packageOf(String from) {
+        int slash = from.indexOf('/');
+        return slash < 0 ? from : from.substring(0, slash);
+    }
+
+    /** The rule key for a screen: "package/.Class" when the class sits in the package, else "package/full.Class". */
+    static String screenKey(String pkg, String cls) {
+        if (cls == null || cls.isEmpty()) return pkg;
+        return pkg + "/" + (cls.startsWith(pkg + ".") ? cls.substring(pkg.length()) : cls);
+    }
+
+    /** The target for a window: its screen's own rule first, then its package's. */
+    static String target(Map<String, String> rules, String pkg, String cls) {
+        String to = rules.get(screenKey(pkg, cls));
+        return to != null ? to : rules.get(pkg);
+    }
+
+    static Map<String, String> load(Context ctx) {
+        SharedPreferences p = prefs(ctx);
+        Set<String> lines = new TreeSet<>(p.getStringSet(KEY, Collections.emptySet()));
+        int seeded = p.getBoolean("seeded", false) ? Math.max(1, p.getInt(SEEDED, 1)) : p.getInt(SEEDED, 0);
+        if (seeded < DEFAULTS.length) {
+            for (int v = seeded; v < DEFAULTS.length; v++) Collections.addAll(lines, DEFAULTS[v]);
+            p.edit().putStringSet(KEY, lines).putInt(SEEDED, DEFAULTS.length).apply();
+        }
+        return parse(lines);
+    }
+
+    static void save(Context ctx, Map<String, String> rules) {
+        Set<String> lines = new TreeSet<>();
+        for (Map.Entry<String, String> e : rules.entrySet()) lines.add(e.getKey() + "=" + e.getValue());
+        prefs(ctx).edit().putStringSet(KEY, lines).putInt(SEEDED, DEFAULTS.length).apply();
+    }
+
+    static SharedPreferences prefs(Context ctx) {
+        return ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+}

+<?xml version="1.0" encoding="utf-8"?>
+<manifest xmlns:android="http://schemas.android.com/apk/res/android">
+
+    <uses-feature android:name="android.software.leanback" android:required="false" />
+    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
+
+    <!-- No permissions: no network, no storage. The accessibility service below only hears which app is in front. -->
+    <!-- Android 11 package visibility: the rule picker lists the installed apps with a launcher entry. -->
+    <queries>
+        <intent>
+            <action android:name="android.intent.action.MAIN" />
+        </intent>
+    </queries>
+
+    <application
+        android:allowBackup="false"
+        android:banner="@drawable/banner"
+        android:icon="@drawable/icon"
+        android:label="@string/app_name"
+        android:supportsRtl="false"
+        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
+
+        <activity
+            android:name=".MainActivity"
+            android:exported="true">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+        </activity>
+
+        <service
+            android:name=".RedirectService"
+            android:exported="false"
+            android:label="@string/service_label"
+            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
+            <intent-filter>
+                <action android:name="android.accessibilityservice.AccessibilityService" />
+            </intent-filter>
+            <meta-data
+                android:name="android.accessibilityservice"
+                android:resource="@xml/redirect_service" />
+        </service>
+    </application>
+</manifest>
diff --git a/addons/remote-buttons/app/src/main/java/io/github/opentvos/remotebuttons/MainActivity.java b/addons/remote-buttons/app/src/main/java/io/github/opentvos/remotebuttons/MainActivity.java
new file mode 100644
index 0000000..aa7ef93
--- /dev/null
+++ b/addons/remote-buttons/app/src/main/java/io/github/opentvos/remotebuttons/MainActivity.java
@@ -0,0 +1,182 @@
+package io.github.opentvos.remotebuttons;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.ComponentName;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.text.TextUtils;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+/**
+ * The rules on one screen: whether the service is on, each "when A opens, open B" rule (OK removes it), and
+ * Add rule, which asks for the two apps from the installed ones. Everything is reachable with the D-pad.
+ */
+public final class MainActivity extends Activity {
+    private LinearLayout list;
+    private float dp;
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        dp = getResources().getDisplayMetrics().density;
+        ScrollView scroll = new ScrollView(this);
+        scroll.setBackgroundColor(0xFF0C0F14);
+        list = new LinearLayout(this);
+        list.setOrientation(LinearLayout.VERTICAL);
+        int pad = Math.round(48 * dp);
+        list.setPadding(pad, Math.round(36 * dp), pad, pad);
+        scroll.addView(list);
+        setContentView(scroll);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        render();
+    }
+
+    private void render() {
+        list.removeAllViews();
+        list.addView(text(getString(R.string.app_name), 34, 0xFFFFFFFF));
+        list.addView(text(getString(R.string.intro), 16, 0xB3FFFFFF));
+
+        boolean on = serviceOn();
+        TextView status = button(getString(on ? R.string.service_on : R.string.service_off));
+        status.setTextColor(on ? 0xFF8BE0A4 : 0xFFFFB0A0);
+        status.setOnClickListener(v -> startActivity(new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)));
+        list.addView(status);
+
+        list.addView(text(getString(R.string.rules_title), 13, 0x99FFFFFF));
+        Map<String, String> rules = Rules.load(this);
+        if (rules.isEmpty()) list.addView(text(getString(R.string.no_rules), 16, 0x99FFFFFF));
+        for (Map.Entry<String, String> e : rules.entrySet()) {
+            TextView row = button(getString(R.string.rule_row, label(e.getKey()), label(e.getValue())));
+            row.setOnClickListener(v -> confirmRemove(e.getKey(), e.getValue()));
+            list.addView(row);
+        }
+        TextView add = button(getString(R.string.add_rule));
+        add.setOnClickListener(v -> pickApp(getString(R.string.pick_from), null));
+        list.addView(add);
+        list.addView(text(getString(R.string.hint), 14, 0x80FFFFFF));
+        (list.getChildAt(2)).requestFocus();
+    }
+
+    private void confirmRemove(String from, String to) {
+        new AlertDialog.Builder(this, android.R.style.Theme_DeviceDefault_Dialog_Alert)
+                .setTitle(getString(R.string.rule_row, label(from), label(to)))
+                .setPositiveButton(R.string.remove, (d, w) -> {
+                    Map<String, String> rules = new LinkedHashMap<>(Rules.load(this));
+                    rules.remove(from);
+                    Rules.save(this, rules);
+                    render();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    /** First call picks the app a button opens (from); the second, with {@code from} set, picks the one to open. */
+    private void pickApp(String title, String from) {
+        Map<String, String> apps = launchableApps();
+        if (from != null) apps.remove(from);
+        List<String> pkgs = new ArrayList<>(apps.values());
+        List<String> names = new ArrayList<>(apps.keySet());
+        new AlertDialog.Builder(this, android.R.style.Theme_DeviceDefault_Dialog_Alert)
+                .setTitle(title)
+                .setItems(names.toArray(new CharSequence[0]), (d, which) -> {
+                    String chosen = pkgs.get(which);
+                    if (from == null) {
+                        pickApp(getString(R.string.pick_to, names.get(which)), chosen);
+                    } else {
+                        Map<String, String> rules = new LinkedHashMap<>(Rules.load(this));
+                        rules.put(from, chosen);
+                        Rules.save(this, rules);
+                        render();
+                    }
+                })
+                .show();
+    }
+
+    /** Label to package for every app with a TV (or phone) launcher entry, sorted by label. */
+    private Map<String, String> launchableApps() {
+        PackageManager pm = getPackageManager();
+        Map<String, String> out = new TreeMap<>(String.CASE_INSENSITIVE_ORDER);
+        for (String category : new String[]{Intent.CATEGORY_LEANBACK_LAUNCHER, Intent.CATEGORY_LAUNCHER}) {
+            Intent i = new Intent(Intent.ACTION_MAIN).addCategory(category);
+            for (ResolveInfo ri : pm.queryIntentActivities(i, 0)) {
+                String pkg = ri.activityInfo.packageName;
+                if (pkg.equals(getPackageName()) || out.containsValue(pkg)) continue;
+                String name = String.valueOf(ri.loadLabel(pm));
+                out.put(out.containsKey(name) ? name + " (" + pkg + ")" : name, pkg);
+            }
+        }
+        return out;
+    }
+
+    private String label(String key) {
+        String pkg = Rules.packageOf(key);
+        String name = appName(pkg);
+        // A one-screen rule (the Google TV home screen) names its screen after the app.
+        return key.contains("/") ? getString(R.string.screen_of, name, key.substring(key.lastIndexOf('.') + 1)) : name;
+    }
+
+    private String appName(String pkg) {
+        try {
+            ApplicationInfo info = getPackageManager().getApplicationInfo(pkg, 0);
+            return String.valueOf(getPackageManager().getApplicationLabel(info));
+        } catch (PackageManager.NameNotFoundException e) {
+            return pkg;
+        }
+    }
+
+    private boolean serviceOn() {
+        String enabled = Settings.Secure.getString(getContentResolver(), Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES);
+        if (enabled == null) return false;
+        String me = new ComponentName(this, RedirectService.class).flattenToString();
+        String shortMe = new ComponentName(this, RedirectService.class).flattenToShortString();
+        TextUtils.SimpleStringSplitter split = new TextUtils.SimpleStringSplitter(':');
+        split.setString(enabled);
+        for (String s : split) if (s.equalsIgnoreCase(me) || s.equalsIgnoreCase(shortMe)) return true;
+        return false;
+    }
+
+    private TextView text(String s, int sp, int colour) {
+        TextView t = new TextView(this);
+        t.setText(s);
+        t.setTextSize(sp);
+        t.setTextColor(colour);
+        t.setPadding(0, Math.round(10 * dp), 0, Math.round(6 * dp));
+        return t;
+    }
+
+    private TextView button(String s) {
+        TextView b = text(s, 18, 0xFFFFFFFF);
+        b.setBackgroundResource(R.drawable.row);
+        int h = Math.round(20 * dp), v = Math.round(12 * dp);
+        b.setPadding(h, v, h, v);
+        b.setFocusable(true);
+        b.setClickable(true);
+        b.setGravity(Gravity.CENTER_VERTICAL);
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT,
+                LinearLayout.LayoutParams.WRAP_CONTENT);
+        lp.topMargin = Math.round(8 * dp);
+        b.setLayoutParams(lp);
+        b.setOnFocusChangeListener((view, focused) -> view.animate().scaleX(focused ? 1.02f : 1f)
+                .scaleY(focused ? 1.02f : 1f).setDuration(120).start());
+        return b;
+    }
+}
diff --git a/addons/remote-buttons/app/src/main/java/io/github/opentvos/remotebuttons/RedirectService.java b/addons/remote-buttons/app/src/main/java/io/github/opentvos/remotebuttons/RedirectService.java
new file mode 100644
index 0000000..1f9e11d
--- /dev/null
+++ b/addons/remote-buttons/app/src/main/java/io/github/opentvos/remotebuttons/RedirectService.java
@@ -0,0 +1,109 @@
+package io.github.opentvos.remotebuttons;
+
+import android.accessibilityservice.AccessibilityService;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.content.pm.PackageManager;
+import android.os.SystemClock;
+import android.view.accessibility.AccessibilityEvent;
+
+import java.util.Collections;
+import java.util.Map;
+
+/**
+ * Watches only which app comes to the front (window state changes) and opens the rule's app instead. It never
+ * asks for key events (no flagRequestFilterKeyEvents in redirect_service.xml) and reads no window content, so
+ * Volume, the arrows, OK and Home keep working exactly as the TV does them, held-key repeat included.
+ */
+public final class RedirectService extends AccessibilityService {
+    /**
+     * How long the from app must stay in front before the target opens. Apps open a second screen of their own
+     * right after the first (YouTube: ShellActivity, then MainActivity ~50 ms later), so redirecting on the first
+     * window leaves the app on top again; waiting for it to settle catches both.
+     */
+    private static final long SETTLE_MS = 350;
+    /** A one-screen rule (the Google TV home) needs no settling: its screen is the final one, so go at once. */
+    private static final long SCREEN_SETTLE_MS = 0;
+    /**
+     * The Assistant shows voice search results in the Google TV home's own screen (tv.google.com deep link, then
+     * launcherx HomeActivity). For this long after the Assistant was in front, a one-screen rule is left alone, so
+     * the results stay; a Home press later still goes to the launcher.
+     */
+    private static final long ASSISTANT_GRACE_MS = 30_000;
+    private static final String ASSISTANT = "com.google.android.katniss";
+    private long assistantAt = -ASSISTANT_GRACE_MS;
+    /** At most this many redirects in {@link #BURST_MS}, so two rules pointing at each other cannot loop. */
+    private static final int BURST_MAX = 6;
+    private static final long BURST_MS = 5000;
+
+    private volatile Map<String, String> rules = Collections.emptyMap();
+    private final android.os.Handler main = new android.os.Handler(android.os.Looper.getMainLooper());
+    /** The package and class of the last window that came to the front, whichever app it was. */
+    private String front = "";
+    private String frontClass = "";
+    private final long[] recent = new long[BURST_MAX];
+    private int recentNext;
+    private final SharedPreferences.OnSharedPreferenceChangeListener reload = (p, key) -> rules = Rules.load(this);
+    private final Runnable settle = this::redirectIfStillInFront;
+
+    @Override
+    protected void onServiceConnected() {
+        rules = Rules.load(this);
+        Rules.prefs(this).registerOnSharedPreferenceChangeListener(reload);
+    }
+
+    @Override
+    public void onAccessibilityEvent(AccessibilityEvent event) {
+        if (event.getEventType() != AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED || event.getPackageName() == null) return;
+        front = event.getPackageName().toString();
+        frontClass = event.getClassName() == null ? "" : event.getClassName().toString();
+        main.removeCallbacks(settle);
+        if (ASSISTANT.equals(front)) assistantAt = SystemClock.elapsedRealtime();
+        if (Rules.target(rules, front, frontClass) == null) return;
+        boolean screen = rules.containsKey(Rules.screenKey(front, frontClass));
+        // Voice search results are shown on this screen: leave them up.
+        if (screen && SystemClock.elapsedRealtime() - assistantAt < ASSISTANT_GRACE_MS) return;
+        main.postDelayed(settle, screen ? SCREEN_SETTLE_MS : SETTLE_MS);
+    }
+
+    private void redirectIfStillInFront() {
+        String to = Rules.target(rules, front, frontClass);
+        if (to == null) return;
+        long now = SystemClock.elapsedRealtime();
+        long oldest = recent[recentNext];
+        if (oldest != 0 && now - oldest < BURST_MS) return;   // a loop, or an app fighting back: stop here
+        Intent launch = launchIntent(getPackageManager(), to);
+        if (launch == null) return;   // the target is not installed or is turned off: leave the app as it is
+        recent[recentNext] = now;
+        recentNext = (recentNext + 1) % BURST_MAX;
+        launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        if (!launch.hasCategory(Intent.CATEGORY_HOME)) launch.addFlags(Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED);
+        // A screen rule (the Google TV home) swaps one home for another: no transition, so the stock one shows less.
+        if (rules.containsKey(Rules.screenKey(front, frontClass))) launch.addFlags(Intent.FLAG_ACTIVITY_NO_ANIMATION);
+        startActivity(launch);
+    }
+
+    /**
+     * A launcher's Home entry first: it brings back the Home already running at once, where its TV entry would
+     * build a second copy (1.5 s on a 1.5 GB TV). Otherwise the app's TV entry, else its phone entry.
+     */
+    static Intent launchIntent(PackageManager pm, String pkg) {
+        Intent home = new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME).setPackage(pkg);
+        android.content.pm.ResolveInfo ri = pm.resolveActivity(home, 0);
+        if (ri != null && ri.activityInfo != null && pkg.equals(ri.activityInfo.packageName)) {
+            return home.setClassName(pkg, ri.activityInfo.name);
+        }
+        Intent i = pm.getLeanbackLaunchIntentForPackage(pkg);
+        return i != null ? i : pm.getLaunchIntentForPackage(pkg);
+    }
+
+    @Override
+    public void onInterrupt() { }
+
+    @Override
+    public void onDestroy() {
+        main.removeCallbacks(settle);
+        Rules.prefs(this).unregisterOnSharedPreferenceChangeListener(reload);
+        super.onDestroy();
+    }
+}
diff --git a/addons/remote-buttons/app/src/main/java/io/github/opentvos/remotebuttons/Rules.java b/addons/remote-buttons/app/src/main/java/io/github/opentvos/remotebuttons/Rules.java

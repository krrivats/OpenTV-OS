+/**
+ * The page's background as a picture of the weather: the gradient of {@link Forecast#backdrop} plus a sun glow by
+ * day, a moon and stars by night, soft clouds, rain streaks, fog bands, snow or a far-off flash. Drawn once into a
+ * half-resolution bitmap (960 x 540) for each new reading and stretched over the screen, never animated, so it
+ * costs one full-screen draw. Everything stays dark enough for the white text on top.
+ */
+final class WeatherScene {
+    private static final int W = 960, H = 540;
+
+    private WeatherScene() { }
+
+    static Drawable draw(Resources res, int code, boolean day) {
+        Bitmap bitmap = Bitmap.createBitmap(W, H, Bitmap.Config.ARGB_8888);
+        Canvas c = new Canvas(bitmap);
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        Random rnd = new Random(code * 31L + (day ? 1 : 0));
+
+        boolean clear = code <= 1, partly = code == 2;
+        boolean fog = code == 45 || code == 48;
+        boolean snow = (code >= 71 && code <= 77) || code == 85 || code == 86;
+        boolean storm = code >= 95;
+        boolean rain = !snow && !storm && code >= 51;
+
+        int[] sky = gradient(code, day);
+        p.setShader(new LinearGradient(0, 0, 0, H, sky, new float[]{0f, 0.55f, 1f}, Shader.TileMode.CLAMP));
+        c.drawRect(0, 0, W, H, p);
+        p.setShader(null);
+
+        if (clear || partly) {
+            if (day) glow(c, p, W * 0.70f, H * 0.13f, 300, 0x66FFD27A);
+            else {
+                stars(c, p, rnd, partly ? 60 : 140);
+                glow(c, p, W * 0.70f, H * 0.13f, 160, 0x33C8D4FF);
+                p.setColor(0xFFE8ECF5);
+                c.drawCircle(W * 0.70f, H * 0.13f, 26, p);
+                p.setColor(sky[0]);
+                c.drawCircle(W * 0.70f + 12, H * 0.13f - 8, 23, p);
+            }
+        }
+        if (partly || code == 3 || rain || storm || snow) {
+            int tone = day ? (rain || storm ? 0x30A0AAB8 : 0x40DDE3EA) : 0x26A0A8C0;
+            int clouds = partly ? 3 : 7;
+            for (int i = 0; i < clouds; i++) {
+                cloud(c, p, 80 + rnd.nextFloat() * (W - 160), 40 + rnd.nextFloat() * H * 0.35f,
+                        90 + rnd.nextFloat() * 90, tone);
+            }
+        }
+        if (rain || storm) {
+            p.setColor(day ? 0x40CFE0F0 : 0x30B0C4E0);
+            p.setStrokeWidth(1.6f);
+            for (int i = 0; i < (storm ? 260 : 180); i++) {
+                float x = rnd.nextFloat() * (W + 60), y = rnd.nextFloat() * H, len = 14 + rnd.nextFloat() * 16;
+                c.drawLine(x, y, x - len * 0.25f, y + len, p);
+            }
+        }
+        if (storm) {
+            glow(c, p, W * 0.25f, H * 0.12f, 220, 0x33B8A8FF);
+            Path bolt = new Path();
+            bolt.moveTo(W * 0.27f, H * 0.10f);
+            bolt.lineTo(W * 0.24f, H * 0.26f);
+            bolt.lineTo(W * 0.265f, H * 0.26f);
+            bolt.lineTo(W * 0.23f, H * 0.42f);
+            p.setStyle(Paint.Style.STROKE);
+            p.setStrokeWidth(3f);
+            p.setColor(0x80E8E0FF);
+            c.drawPath(bolt, p);
+            p.setStyle(Paint.Style.FILL);
+        }
+        if (snow) {
+            for (int i = 0; i < 220; i++) {
+                p.setColor(0x26FFFFFF + (rnd.nextInt(3) << 28));
+                c.drawCircle(rnd.nextFloat() * W, rnd.nextFloat() * H, 1.2f + rnd.nextFloat() * 2.2f, p);
+            }
+        }
+        if (fog) {
+            for (int i = 0; i < 6; i++) {
+                float y = H * (0.25f + i * 0.13f);
+                p.setShader(new LinearGradient(0, y - 30, 0, y + 30, new int[]{0x00FFFFFF, 0x1FFFFFFF, 0x00FFFFFF},
+                        null, Shader.TileMode.CLAMP));
+                c.drawRect(0, y - 30, W, y + 30, p);
+            }
+            p.setShader(null);
+        }
+        // Darker towards the bottom, where the forecast cards sit.
+        p.setShader(new LinearGradient(0, H * 0.45f, 0, H, 0x00000000, 0x8C000000, Shader.TileMode.CLAMP));
+        c.drawRect(0, 0, W, H, p);
+
+        BitmapDrawable drawable = new BitmapDrawable(res, bitmap);
+        drawable.setGravity(Gravity.FILL);
+        drawable.setFilterBitmap(true);
+        return drawable;
+    }
+
+    /** Top, middle and bottom colours for the weather; the same families as {@link Forecast#backdrop}, a little richer. */
+    static int[] gradient(int code, boolean day) {
+        if (code <= 2) return day ? new int[]{0xFF2C6DB0, 0xFF1D4E80, 0xFF0B1A2C}
+                : new int[]{0xFF0A1433, 0xFF0C1A3A, 0xFF03050C};
+        if (code == 45 || code == 48) return new int[]{0xFF5C636C, 0xFF3A3F46, 0xFF101113};
+        if ((code >= 71 && code <= 77) || code == 85 || code == 86) return new int[]{0xFF71879B, 0xFF44566A, 0xFF101820};
+        if (code >= 95) return new int[]{0xFF2E2242, 0xFF1A1428, 0xFF07050C};
+        if (code >= 51) return day ? new int[]{0xFF2A3A4E, 0xFF1C2838, 0xFF06090E}
+                : new int[]{0xFF141C2A, 0xFF0E141E, 0xFF04060A};
+        return day ? new int[]{0xFF46525F, 0xFF2E3742, 0xFF0C0F14} : new int[]{0xFF1E242E, 0xFF151A22, 0xFF06080B};
+    }
+
+    private static void glow(Canvas c, Paint p, float x, float y, float r, int colour) {
+        p.setShader(new RadialGradient(x, y, r, colour, colour & 0x00FFFFFF, Shader.TileMode.CLAMP));
+        c.drawCircle(x, y, r, p);
+        p.setShader(null);
+    }
+
+    private static void stars(Canvas c, Paint p, Random rnd, int n) {
+        for (int i = 0; i < n; i++) {
+            p.setColor((0x40 + rnd.nextInt(0x80)) << 24 | 0xFFFFFF);
+            c.drawCircle(rnd.nextFloat() * W, rnd.nextFloat() * H * 0.55f, 0.6f + rnd.nextFloat() * 1.2f, p);
+        }
+    }
+
+    /** A soft cloud: a few overlapping radial puffs. */
+    private static void cloud(Canvas c, Paint p, float x, float y, float size, int colour) {
+        float[][] puffs = {{0, 0, 1f}, {-0.7f, 0.15f, 0.7f}, {0.7f, 0.12f, 0.75f}, {0.3f, -0.3f, 0.65f}, {-0.3f, -0.2f, 0.6f}};
+        for (float[] f : puffs) glow(c, p, x + f[0] * size, y + f[1] * size, size * f[2], colour);
+    }
+}

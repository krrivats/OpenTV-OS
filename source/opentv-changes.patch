+++ b/launcher/app/src/main/java/com/gathin/tvhome/VoiceSearchActivity.java
@@ -0,0 +1,64 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.content.ActivityNotFoundException;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+import android.speech.RecognizerIntent;
+
+import java.util.ArrayList;
+
+/**
+ * The app_keys target "voice-search": the TV's own speech recognition (Google's, on Google TV), then the words as
+ * a YouTube search opened in voice_search_app (SmartTube by default). On a Google TV whose Google TV home and stock
+ * YouTube are off, the Assistant's video results have nowhere to open ("having trouble"); this gives the mic button
+ * on Home a search that lands in SmartTube. Invisible: only the TV's listening screen shows.
+ */
+public class VoiceSearchActivity extends Activity {
+
+    private static final int LISTEN = 1;
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        if (state != null) return;   // recreated while the recogniser is up: its result still comes back here
+        Intent listen = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH)
+                .putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_WEB_SEARCH)
+                .putExtra(RecognizerIntent.EXTRA_PROMPT, getString(R.string.voice_search_prompt))
+                .putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 1);
+        try {
+            startActivityForResult(listen, LISTEN);
+        } catch (ActivityNotFoundException e) {
+            finish();   // no speech recognition on this TV
+        }
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        String words = null;
+        if (requestCode == LISTEN && resultCode == RESULT_OK && data != null) {
+            ArrayList<String> heard = data.getStringArrayListExtra(RecognizerIntent.EXTRA_RESULTS);
+            if (heard != null && !heard.isEmpty()) words = heard.get(0);
+        }
+        if (words != null && !words.trim().isEmpty()) open(words.trim());
+        finish();
+    }
+
+    /** The words as a YouTube search link: SmartTube opens it on its search results; any YouTube app would too. */
+    private void open(String words) {
+        Uri search = Uri.parse("https://www.youtube.com/results?search_query=" + Uri.encode(words));
+        String app = Config.load(this).voiceSearchApp;
+        Intent view = new Intent(Intent.ACTION_VIEW, search).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        if (!app.isEmpty()) view.setPackage(app);
+        try {
+            startActivity(view);
+        } catch (ActivityNotFoundException e) {
+            try {
+                startActivity(view.setPackage(null));   // the named app is gone: whichever app opens YouTube links
+            } catch (ActivityNotFoundException ignored) {
+            }
+        }
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/Weather.java b/launcher/app/src/main/java/com/gathin/tvhome/Weather.java
new file mode 100644
index 0000000..8b01827
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/Weather.java
@@ -0,0 +1,114 @@
+package com.gathin.tvhome;
+
+import java.util.Locale;
+
+/**
+ * Weather mood for the sky backdrop (theme key weather_mood): maps a WMO weather code and the temperature to a
+ * mood, and tints a {@link Sky.Palette} towards it. Pure maths, no Android types, so it is tested on the JVM.
+ * Every tint target is dark, so the white text keeps its contrast whatever the weather.
+ */
+final class Weather {
+
+    enum Mood { CLEAR, HOT, COLD, CLOUDY, FOG, RAIN, STORM, SNOW }
+
+    private Weather() {
+    }
+
+    /** The mood for WMO code {@code code} (Open-Meteo's weather_code) at {@code tempC} degrees. */
+    static Mood mood(int code, double tempC) {
+        if (code >= 95) return Mood.STORM;
+        if ((code >= 71 && code <= 77) || code == 85 || code == 86) return Mood.SNOW;
+        if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) return Mood.RAIN;
+        if (code == 45 || code == 48) return Mood.FOG;
+        if (code == 3) return Mood.CLOUDY;
+        if (tempC >= 33) return Mood.HOT;
+        if (tempC <= 10) return Mood.COLD;
+        return Mood.CLEAR;
+    }
+
+    /** The pill's icon for the weather now: sun or moon when clear, else the weather's own. */
+    static int icon(Mood m, boolean day) {
+        switch (m) {
+            case CLOUDY: return R.drawable.ic_wx_cloud;
+            case FOG: return R.drawable.ic_wx_fog;
+            case RAIN: return R.drawable.ic_wx_rain;
+            case STORM: return R.drawable.ic_wx_storm;
+            case SNOW: return R.drawable.ic_wx_snow;
+            default: return day ? R.drawable.ic_wx_sun : R.drawable.ic_wx_moon;
+        }
+    }
+
+    /** A short English word for the code, for the line under the date. */
+    static String label(int code) {
+        if (code == 0) return "Clear";
+        if (code <= 2) return "Partly cloudy";
+        if (code == 3) return "Cloudy";
+        if (code == 45 || code == 48) return "Fog";
+        if (code >= 51 && code <= 57) return "Drizzle";
+        if ((code >= 61 && code <= 67) || (code >= 80 && code <= 82)) return "Rain";
+        if ((code >= 71 && code <= 77) || code == 85 || code == 86) return "Snow";
+        if (code >= 95) return "Thunderstorm";
+        return "";
+    }
+
+    /** "24° · Clear · Jaipur" style line; the place is left out when empty. */
+    static String line(double tempC, int code, String place) {
+        StringBuilder sb = new StringBuilder();
+        sb.append(String.format(Locale.ROOT, "%d°", Math.round(tempC)));
+        String l = label(code);
+        if (!l.isEmpty()) sb.append("  ·  ").append(l);
+        if (place != null && !place.isEmpty()) sb.append("  ·  ").append(place);
+        return sb.toString();
+    }
+
+    /** The colour the backdrop leans towards, and how far (0 to 1). */
+    private static int target(Mood m) {
+        switch (m) {
+            case HOT: return 0xFF6A2A12;
+            case COLD: return 0xFF14304E;
+            case CLOUDY: return 0xFF252B36;
+            case FOG: return 0xFF35322D;
+            case RAIN: return 0xFF0C2638;
+            case STORM: return 0xFF181230;
+            case SNOW: return 0xFF3E4A5C;
+            default: return 0;
+        }
+    }
+
+    private static float amount(Mood m) {
+        switch (m) {
+            case HOT: return 0.35f;
+            case COLD: return 0.35f;
+            case CLOUDY: return 0.45f;
+            case FOG: return 0.55f;
+            case RAIN: return 0.5f;
+            case STORM: return 0.6f;
+            case SNOW: return 0.4f;
+            default: return 0f;
+        }
+    }
+
+    /** The sun glow left in each mood: none under rain, faint through fog and cloud, warmer in the heat. */
+    private static float sunScale(Mood m) {
+        switch (m) {
+            case HOT: return 1.2f;
+            case CLOUDY: return 0.45f;
+            case FOG: return 0.3f;
+            case RAIN:
+            case STORM: return 0f;
+            case SNOW: return 0.5f;
+            default: return 1f;
+        }
+    }
+
+    /** {@code p} tinted towards {@code m}; CLEAR (and null) return it as it is. */
+    static Sky.Palette tint(Sky.Palette p, Mood m) {
+        if (m == null || m == Mood.CLEAR) return p;
+        int t = target(m);
+        float a = amount(m);
+        int sun = Math.max(0, Math.min(255, Math.round(p.sun * sunScale(m))));
+        // The bottom carries the horizon glow, so it moves the most; the top stays nearest night.
+        return new Sky.Palette(Sky.lerpColor(p.top, t, a * 0.6f), Sky.lerpColor(p.mid, t, a),
+                Sky.lerpColor(p.bottom, t, Math.min(1f, a * 1.15f)), sun, p.sunX);
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/WeatherFeed.java b/launcher/app/src/main/java/com/gathin/tvhome/WeatherFeed.java
new file mode 100644
index 0000000..df3c8ff
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/WeatherFeed.java
@@ -0,0 +1,92 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Handler;
+import android.os.Looper;
+
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+
+/**
+ * Current weather from Open-Meteo (free, no key, no account) for weather_mood. Asked only while Home is on
+ * screen and at most every {@link #MAX_AGE_MS}; the last answer is kept in preferences so Home starts with it
+ * and an offline TV keeps the last mood. Sends nothing but the place's latitude and longitude.
+ */
+final class WeatherFeed {
+
+    interface Listener {
+        void onWeather(double tempC, int code);
+    }
+
+    private static final String PREFS = "weather";
+    private static final long MAX_AGE_MS = 30 * 60_000L;
+
+    private final SharedPreferences prefs;
+    private final String lat;
+    private final String lon;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private volatile boolean busy;
+
+    WeatherFeed(Context ctx, String lat, String lon) {
+        prefs = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        this.lat = lat;
+        this.lon = lon;
+    }
+
+    boolean usable() {
+        try {
+            Double.parseDouble(lat);
+            Double.parseDouble(lon);
+            return true;
+        } catch (NumberFormatException | NullPointerException e) {
+            return false;
+        }
+    }
+
+    /** Hands the cached weather to {@code l}, if any, then asks Open-Meteo when the cache is old. */
+    void refresh(Listener l) {
+        if (!usable()) return;
+        if (prefs.contains("code")) l.onWeather(prefs.getFloat("temp", 0f), prefs.getInt("code", 0));
+        long age = System.currentTimeMillis() - prefs.getLong("at", 0L);
+        if (busy || age >= 0 && age < MAX_AGE_MS) return;
+        busy = true;
+        new Thread(() -> {
+            try {
+                JSONObject cur = new JSONObject(get()).getJSONObject("current");
+                double temp = cur.getDouble("temperature_2m");
+                int code = cur.getInt("weather_code");
+                prefs.edit().putFloat("temp", (float) temp).putInt("code", code)
+                        .putLong("at", System.currentTimeMillis()).apply();
+                main.post(() -> l.onWeather(temp, code));
+            } catch (Exception ignored) {
+                // Offline or a bad answer: keep the last mood and try again on the next return to Home.
+            } finally {
+                busy = false;
+            }
+        }, "weather").start();
+    }
+
+    private String get() throws Exception {
+        URL url = new URL(String.format(Locale.ROOT,
+                "https://api.open-meteo.com/v1/forecast?latitude=%s&longitude=%s&current=temperature_2m,weather_code",
+                lat.trim(), lon.trim()));
+        HttpURLConnection c = (HttpURLConnection) url.openConnection();
+        c.setConnectTimeout(8000);
+        c.setReadTimeout(8000);
+        try (InputStream in = c.getInputStream()) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[4096];
+            for (int n; (n = in.read(buf)) > 0; ) out.write(buf, 0, n);
+            return new String(out.toByteArray(), StandardCharsets.UTF_8);
+        } finally {
+            c.disconnect();
+        }
+    }
+}

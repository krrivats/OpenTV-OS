diff --git a/launcher/app/src/test/java/com/gathin/tvhome/FestivalAutoTest.java b/launcher/app/src/test/java/com/gathin/tvhome/FestivalAutoTest.java
new file mode 100644
index 0000000..968034b
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/FestivalAutoTest.java
@@ -0,0 +1,135 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.time.LocalDate;
+import java.util.Arrays;
+import java.util.Collections;
+
+public class FestivalAutoTest {
+
+    private static Festival auto(String... extra) {
+        return Festival.parse("auto", "", "", "", true, Arrays.asList(extra));
+    }
+
+    private static Festival on(int y, int m, int d, String... extra) {
+        return auto(extra).resolve(LocalDate.of(y, m, d));
+    }
+
+    @Test
+    public void autoIsNeverActiveItself() {
+        assertFalse(auto().active(LocalDate.of(2026, 11, 8)));
+    }
+
+    @Test
+    public void countdownStartsFourteenDaysBefore() {
+        // Diwali 2026 runs 6-11 November.
+        assertSame(Festival.NONE, on(2026, 10, 22));
+        Festival f = on(2026, 10, 23);
+        assertEquals("diwali", f.name);
+        assertEquals(14, f.daysUntil);
+        assertFalse(f.onDay);
+        assertEquals(1, on(2026, 11, 5).daysUntil);
+    }
+
+    @Test
+    public void festivalDaysShowTheGreetingAndThePetals() {
+        Festival f = on(2026, 11, 8);
+        assertEquals("diwali", f.name);
+        assertEquals(0, f.daysUntil);
+        assertTrue(f.onDay);
+    }
+
+    @Test
+    public void afterTheDaysTheNearerFestivalWins() {
+        // Diwali ends 11 Nov, Gurpurab is 24 Nov.
+        Festival after = on(2026, 11, 13);
+        assertEquals("diwali", after.name);
+        assertFalse(after.onDay);
+        assertEquals(0, after.daysUntil);
+        Festival next = on(2026, 11, 19);
+        assertEquals("gurpurab", next.name);
+        assertEquals(5, next.daysUntil);
+    }
+
+    @Test
+    public void theHandOverIsHalfwayBetween() {
+        // Diwali ends 11 Nov, Gurpurab is 24 Nov: 17 Nov is 6 days after one and 7 before the other.
+        assertEquals("diwali", on(2026, 11, 17).name);
+        assertEquals("gurpurab", on(2026, 11, 18).name);
+    }
+
+    @Test
+    public void theComingFestivalWinsATie() {
+        // 3 days after one and 3 days before the other.
+        assertEquals("b", on(2030, 5, 4, "2030-05-01..2030-05-01=a", "2030-05-07..2030-05-07=b").name);
+    }
+
+    @Test
+    public void ownDaysAlwaysWin() {
+        // Dussehra 9 Oct 2027 sits inside Navratri's after-window and Karwa Chauth's lead.
+        assertEquals("dussehra", on(2027, 10, 9).name);
+        assertEquals("karwachauth", on(2027, 10, 18).name);
+    }
+
+    @Test
+    public void nationalDaysAreShort() {
+        assertSame(Festival.NONE, on(2030, 8, 11));
+        assertEquals(3, on(2030, 8, 12).daysUntil);
+        assertEquals("independence", on(2030, 8, 16).name);
+        assertSame(Festival.NONE, on(2030, 8, 17));
+        assertFalse(on(2030, 8, 15).icons);
+    }
+
+    @Test
+    public void yearlyDaysRepeatAcrossTheNewYear() {
+        assertEquals("republic", on(2031, 1, 26).name);
+        assertEquals("newyear", on(2030, 12, 31).name);
+        assertEquals("newyear", on(2031, 1, 1).name);
+        // Two days after Christmas, New Year (4 days away) is in its 3-day lead only from 28 Dec.
+        assertSame(Festival.NONE, on(2030, 12, 27));
+        assertEquals(3, on(2030, 12, 28).daysUntil);
+    }
+
+    @Test
+    public void themeEntriesComeFirstWithTheirOwnGreetingAndColour() {
+        Festival f = on(2026, 11, 8, "2026-11-08..2026-11-08=diwali=Shubh Deepavali=#FF0000");
+        assertEquals("Shubh Deepavali", f.greeting);
+        assertEquals(0xFFFF0000, f.accentColor());
+        assertFalse(f.ownGreeting());
+    }
+
+    @Test
+    public void eachFestivalHasItsOwnAccent() {
+        assertEquals(0xFFFF4FA3, on(2027, 3, 22).accentColor());
+    }
+
+    @Test
+    public void iconsSwitchOffForTheWholeCalendar() {
+        Festival f = Festival.parse("auto", "", "", "", false, Collections.emptyList());
+        assertFalse(f.resolve(LocalDate.of(2026, 11, 8)).icons);
+    }
+
+    @Test
+    public void malformedEntriesAreSkipped() {
+        assertEquals("diwali", on(2026, 11, 8, "nonsense", "2026-13-01..2026-13-02=x", "2026-11-09..2026-11-01=y").name);
+    }
+
+    @Test
+    public void festivalUntilEndsAuto() {
+        Festival f = Festival.parse("auto", "2026-11-07", "", "", true, Collections.emptyList());
+        assertSame(Festival.NONE, f.resolve(LocalDate.of(2026, 11, 8)));
+    }
+
+    @Test
+    public void sameAsTracksTheCountdown() {
+        assertTrue(on(2026, 11, 1).sameAs(on(2026, 11, 1)));
+        assertFalse(on(2026, 11, 1).sameAs(on(2026, 11, 2)));
+        assertTrue(Festival.NONE.sameAs(Festival.NONE));
+    }
+}

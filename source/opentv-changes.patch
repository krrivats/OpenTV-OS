+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+public class WeatherTest {
+
+    @Test
+    public void codesMapToMoods() {
+        assertEquals(Weather.Mood.CLEAR, Weather.mood(0, 24));
+        assertEquals(Weather.Mood.HOT, Weather.mood(1, 41));
+        assertEquals(Weather.Mood.COLD, Weather.mood(0, 6));
+        assertEquals(Weather.Mood.CLOUDY, Weather.mood(3, 24));
+        assertEquals(Weather.Mood.FOG, Weather.mood(45, 9));
+        assertEquals(Weather.Mood.RAIN, Weather.mood(63, 28));
+        assertEquals(Weather.Mood.RAIN, Weather.mood(81, 28));
+        assertEquals(Weather.Mood.STORM, Weather.mood(95, 30));
+        assertEquals(Weather.Mood.SNOW, Weather.mood(73, -2));
+    }
+
+    @Test
+    public void lineReadsWell() {
+        assertEquals("24°  ·  Clear  ·  Jaipur", Weather.line(23.6, 0, "Jaipur"));
+        assertEquals("-3°  ·  Snow", Weather.line(-3.2, 71, ""));
+    }
+
+    @Test
+    public void clearKeepsThePalette() {
+        Sky.Palette p = Sky.at(600);
+        assertSame(p, Weather.tint(p, Weather.Mood.CLEAR));
+        assertSame(p, Weather.tint(p, null));
+    }
+
+    @Test
+    public void festiveWarmsTheHorizonAndStaysDark() {
+        Sky.Palette night = Sky.at(60);
+        Sky.Palette p = Sky.festive(night, 0xFFFFB23C);
+        assertTrue(((p.bottom >> 16) & 0xFF) > ((night.bottom >> 16) & 0xFF));
+        assertTrue(p.sun >= 120);
+        int lum = ((p.bottom >> 16) & 0xFF) + ((p.bottom >> 8) & 0xFF) + (p.bottom & 0xFF);
+        assertTrue(lum < 3 * 120);
+        assertSame(night, Sky.festive(night, 0));
+    }
+
+    @Test
+    public void rainPutsTheSunOutAndStaysDark() {
+        Sky.Palette p = Weather.tint(Sky.at(1140), Weather.Mood.RAIN);
+        assertEquals(0, p.sun);
+        for (int c : new int[]{p.top, p.mid, p.bottom}) {
+            int lum = ((c >> 16) & 0xFF) + ((c >> 8) & 0xFF) + (c & 0xFF);
+            assertTrue("too bright for white text: " + Integer.toHexString(c), lum < 3 * 180);
+        }
+    }
+}

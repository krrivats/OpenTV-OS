+    android:width="320dp" android:height="180dp"
+    android:viewportWidth="320" android:viewportHeight="180">
+    <path android:fillColor="#FF1B1F2A" android:pathData="M0,0h320v180h-320z" />
+    <path android:fillColor="#FF2E3443" android:pathData="M136,20h48a14,14 0,0 1,14 14v112a14,14 0,0 1,-14 14h-48a14,14 0,0 1,-14 -14v-112a14,14 0,0 1,14 -14z" />
+    <path android:fillColor="#FF5A6272" android:pathData="M160,62m-18,0a18,18 0,1 1,36 0a18,18 0,1 1,-36 0" />
